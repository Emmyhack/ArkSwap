# ArkSwap frontend configuration (llm.txt s39, s40).
#
# Copy to .env.local. Every value must come from real Ark Constellation devnet
# documentation and from deployments/ark-devnet.json. Nothing is hardcoded in the
# app: with these unset the UI renders a blocking "Configuration required" screen
# rather than guessing (llm.txt s3, s57).

NEXT_PUBLIC_ARK_EVM_CHAIN_ID=
NEXT_PUBLIC_ARK_RPC_URL=
NEXT_PUBLIC_ARK_WS_URL=
NEXT_PUBLIC_ARK_BLOCKSCOUT_URL=

# Canonical WKASH. ArkSwap never deploys its own wrapper.
NEXT_PUBLIC_WKASH_ADDRESS=

NEXT_PUBLIC_ARKSWAP_FACTORY_ADDRESS=
NEXT_PUBLIC_ARKSWAP_ROUTER_ADDRESS=

# Devnet mocks. Rendered with a "no real value" badge.
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=
