# ArkSwap V1 deployment environment.
#
#   cp .env.example .env && $EDITOR .env
#
# .env is gitignored. NEVER commit a real private key (llm.txt s24, s37, s57).
#
# ------------------------------------------------------------------------------
# EVERY VALUE BELOW MUST COME FROM ARK CONSTELLATION INTERNAL DEVNET
# DOCUMENTATION. DO NOT GUESS OR INVENT ANY OF THEM (llm.txt s3, s57).
# The deployment scripts refuse to run when a required value is missing, and
# assert `block.chainid == ARK_EVM_CHAIN_ID` before broadcasting anything.
# ------------------------------------------------------------------------------

# --- Ark Constellation devnet endpoints ---------------------------------------
ARK_RPC_URL=
ARK_WS_URL=
ARK_EVM_CHAIN_ID=
ARK_COMETBFT_CHAIN_ID=
ARK_BLOCKSCOUT_URL=
ARK_BLOCKSCOUT_API_URL=
ARK_BLOCKSCOUT_API_KEY=
ARK_FAUCET_URL=

# --- Canonical wrapped native asset -------------------------------------------
# The canonical WKASH deployment. ArkSwap NEVER deploys its own wrapper
# (llm.txt s14, s57). Scripts verify symbol() == "WKASH" and decimals() == 18
# before using this address.
WKASH_ADDRESS=

# --- Deployer -----------------------------------------------------------------
# Devnet only. For testnet/mainnet the canonical deployment must be signed under
# a process agreed with the Ark core team (llm.txt s25, s53).
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- Factory privilege --------------------------------------------------------
# feeToSetter can change protocol-fee configuration (and nothing else -- it can
# never seize liquidity, pause pairs or alter swap math). Do NOT use a personal
# EOA for a long-lived canonical deployment; prefer an Ark team multisig
# (llm.txt s8, s25).
FEE_TO_SETTER=

# --- Devnet mock assets (llm.txt s15) -----------------------------------------
# Populated by script/DeployMocks.s.sol. NOT real stablecoins.
MOCK_USDC_ADDRESS=
MOCK_USDT_ADDRESS=

# --- Populated after deployment -----------------------------------------------
ARKSWAP_FACTORY_ADDRESS=
ARKSWAP_ROUTER_ADDRESS=
WKASH_MUSDC_PAIR_ADDRESS=

# --- Seeding / smoke-test parameters (optional, sane defaults in-script) -------
# Devnet reference pricing is 1 KASH = 1 mUSDC. Arbitrary test valuation only.
SEED_KASH_AMOUNT=10000000000000000000000
SEED_MUSDC_AMOUNT=10000000000
SEED_SLIPPAGE_BPS=50
SMOKE_KASH_IN=1000000000000000000

# ==============================================================================
# Analytics backend — apps/indexer and apps/api (llm.txt s4)
# ==============================================================================
# The indexer and API read the same canonical deployment data as the frontend
# (packages/addresses). These variables cover everything that is environment
# specific or must not be committed.

# Block the ArkSwapFactory was deployed in. Historical sync starts here; the
# indexer never scans from genesis (llm.txt s8, s16).
ARKSWAP_FACTORY_DEPLOYMENT_BLOCK=

# PostgreSQL. A rebuildable projection of chain history, never a source of truth.
DATABASE_URL=postgres://arkswap:arkswap@localhost:5432/arkswap?sslmode=disable

API_PORT=8080

# safeBlock = chainHead - INDEXER_CONFIRMATIONS. Confirm Ark's CometBFT finality
# expectations with the Ark core team before production (llm.txt s18).
INDEXER_CONFIRMATIONS=3

BLOCK_BATCH_SIZE=2000
MAX_RPC_RETRIES=5
RPC_TIMEOUT_SECONDS=15
LOG_LEVEL=info

# Never wildcard in production (llm.txt s44).
ALLOWED_ORIGINS=http://localhost:3000

# Pools thinner than this are rejected as price sources (llm.txt s23).
MIN_PRICE_LIQUIDITY_USD=1000

# Optional
# REDIS_URL=

# --- Frontend -> analytics API (llm.txt s54) ---------------------------------
# Optional. With this unset the UI simply hides analytics; swapping, adding and
# removing liquidity continue to work directly on-chain (llm.txt s38).
NEXT_PUBLIC_ARKSWAP_API_URL=http://localhost:8080/api/v1
