{
  "name": "arkswap",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "ArkSwap monorepo \u2014 Uniswap V2-style AMM, indexer and analytics API for Ark Constellation",
  "scripts": {
    "web:dev": "pnpm --filter @arkswap/web dev",
    "web:build": "pnpm --filter @arkswap/web build",
    "abis:generate": "node scripts/generate-abis.mjs",
    "contracts:build": "pnpm --dir packages/contracts exec forge build",
    "contracts:test": "pnpm --dir packages/contracts exec forge test",
    "contracts:gate": "make -C packages/contracts gate",
    "api:dev": "go run ./apps/api/cmd/api",
    "indexer:dev": "go run ./apps/indexer/cmd/indexer",
    "go:build": "go build -o /dev/null ./apps/api/... ./apps/indexer/... ./packages/gointernal/...",
    "go:test": "go test ./packages/gointernal/...",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "indexer:once": "go run ./apps/indexer/cmd/indexer --once",
    "sdk:test": "pnpm --filter @arkswap/sdk test"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.0"
  }
}
