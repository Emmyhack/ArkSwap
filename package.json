{
  "name": "arkswap",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "description": "ArkSwap monorepo — Uniswap V2-style AMM, indexer and analytics API for Ark Constellation",
  "scripts": {
    "web:dev": "pnpm --filter @arkswap/web dev",
    "web:build": "pnpm --filter @arkswap/web build",
    "abis:generate": "node scripts/generate-abis.mjs",
    "contracts:build": "pnpm --dir packages/contracts exec forge build",
    "contracts:test": "pnpm --dir packages/contracts exec forge test",
    "contracts:gate": "make -C packages/contracts gate",
    "api:dev": "cd apps/api && go run ./cmd/api",
    "indexer:dev": "cd apps/indexer && go run ./cmd/indexer",
    "go:build": "go build ./...",
    "go:test": "go test ./...",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.0"
  }
}
