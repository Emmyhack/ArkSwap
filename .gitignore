# Foundry
out/
cache/
broadcast/

# Secrets -- NEVER commit a real key or a populated .env (llm.txt s24, s57)
.env
.env.*
!.env.example

# Node / frontend
node_modules/
dist/
.next/
tools/solc/*/node_modules/
tools/solc/*/package-lock.json

# OS
.DS_Store

# Local preview stack (script/LocalPreview.s.sol) — anvil only, not a real deployment
packages/addresses/local-preview.json

# Turborepo
.turbo/

# Go build output. `go build ./apps/...` drops binaries in the working directory,
# so the bare names are ignored at the repo root too.
apps/api/bin/
apps/indexer/bin/
/api
/indexer

# Local Postgres data if someone runs it outside Docker
pgdata/
